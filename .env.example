# ==============================================================================
# Prometheus Enterprise Environment Configuration
# ==============================================================================

# Google Cloud Vertex AI & Gemini Enterprise Agent Platform
USE_VERTEX_AI=true
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=8.0
CACHE_TTL_SECONDS=900

# Application Settings & Gemini Enterprise Agent Engine
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Model Context Protocol (MCP)
MCP_ENABLED=true
MCP_TRANSPORT=stdio,sse

# Persistence (SQLite for local / free-tier; Cloud SQL / PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./prometheus_state.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prometheus

# Workstream Integrations (Optional / Hermetic mocks provided)
GITHUB_TOKEN=
GITHUB_REPOS=acme/auth-service,acme/web-gateway,acme/billing-core
JIRA_API_TOKEN=
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=dev-lead@company.com
SLACK_BOT_TOKEN=
SLACK_CHANNELS=platform-engineering,billing-squad

# Security & ABAC Controls
DEFAULT_ORG_SCOPE=engineering,platform
ENFORCE_HUMAN_IN_THE_LOOP=true
