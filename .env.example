# ==============================================================================
# Prometheus Environment Configuration
# ==============================================================================

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Persistence (SQLite for local / free-tier; PostgreSQL for production / Supabase / Neon)
DATABASE_URL=sqlite+aiosqlite:///./prometheus_state.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prometheus

# Workstream Integrations (Optional / Mocked in test environment)
GITHUB_TOKEN=your_github_token_here
JIRA_API_TOKEN=your_jira_token_here
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Security & ABAC Controls
DEFAULT_ORG_SCOPE=engineering,platform
ENFORCE_HUMAN_IN_THE_LOOP=true
